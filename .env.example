# Unreal Studio Web — variables de entorno
#
# El frontend NO necesita variables de entorno: la URL de Supabase y la
# anon key viven en `lib/supabase.ts` (claves públicas, seguras de exponer).
#
# El backend (Edge Functions) sí necesita estas variables. Configurar con:
#   supabase secrets set GHL_API_TOKEN=... GHL_LOCATION_ID=... ...
#
# ─── Supabase Edge Functions ───────────────────────────────────────────────
# Token de la cuenta de GHL con permisos de lectura sobre conversaciones,
# pipelines y opportunities.
GHL_API_TOKEN=

# ID de la location de GHL (Unreal Studio Madrid).
GHL_LOCATION_ID=

# Pipelines de GHL que se exponen al dashboard `/admin/marketing`.
# Si no se definen, se usan estos defaults.
GHL_PIPELINE_PRINCIPAL_ID=X5mByoeHMbsYrFJbM4GP
GHL_PIPELINE_LISTING_ID=YNiATL5JmkQ5ZtpRuWLr

# Webhook secret usado por la función `ghl-sync` (ya existente).
WEBHOOK_SECRET=

# SMTP para `team-notify` (ya existente).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Despliegue de Edge Functions ──────────────────────────────────────────
# Comandos:
#   supabase login
#   supabase link --project-ref rnielxgackkshnatvagj
#   supabase secrets set GHL_API_TOKEN=... GHL_LOCATION_ID=...
#   supabase functions deploy ghl-dashboard
#
# Verificación:
#   curl -H "Authorization: Bearer $SESSION_TOKEN" \
#        https://rnielxgackkshnatvagj.supabase.co/functions/v1/ghl-dashboard
